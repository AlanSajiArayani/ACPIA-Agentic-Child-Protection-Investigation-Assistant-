# ==============================================================================
# ACPIA — Agentic Child Protection Investigation Assistant
# Global Environment Variables Template (.env.example)
# Copy to .env and adjust values for local development
# ==============================================================================

# General Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-super-secret-key-32bytes

# Frontend Settings (Next.js)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Backend Settings (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL + pgvector Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=acpia_db
POSTGRES_USER=acpia_admin
POSTGRES_PASSWORD=acpia_secure_pass_2026
DATABASE_URL=postgresql+asyncpg://acpia_admin:acpia_secure_pass_2026@postgres:5432/acpia_db

# Neo4j Graph Database
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=acpia_graph_pass_2026
NEO4J_URI=bolt://neo4j:7687

# Local AI Engine (Ollama)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3:8b

# Workflow Orchestration (n8n)
N8N_HOST=http://n8n:5678
N8N_PORT=5679
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=acpia_n8n_pass_2026
N8N_WEBHOOK_SECRET=acpia_n8n_webhook_secret_key

# Synthetic Data Guardrails
SYNTHETIC_DATA_ONLY=true
